{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    ".cache/**",
    ".gocache*/**",
    ".gomodcache*/**",
    ".agents/skills-deferred/**",
    "tools/registry/runs/**",
    "tools/diagnostics/**",
    "services/dsh/evidence/**",
    "infra/**",
    "governance/**",
    ".github/**",
    "**/clients/generated/**",
    "**/contracts/generated/**"
  ],
  "ignoreDependencies": [
    "@react-native-async-storage/async-storage",
    "@react-native-community/netinfo",
    "@react-native/metro-config",
    "expo-file-system",
    "expo-haptics",
    "expo-image-picker",
    "expo-location",
    "expo-system-ui",
    "expo-updates",
    "react-native-gesture-handler",
    "react-native-maps",
    "react-native-reanimated",
    "react-native-screens",
    "react-native-svg",
    "react-native-worklets",
    "react-native-web",
    "@bthwani/app-shell",
    "@expo/vector-icons",
    "@types/react",
    "@ast-grep/cli",
    "@stoplight/spectral-cli",
    "autocannon",
    "babel-plugin-react-compiler",
    "dependency-cruiser",
    "markdownlint-cli2",
    "sherif",
    "size-limit"
  ],
  "ignoreBinaries": [
    "dev",
    "go",
    "pwsh",
    "graphify",
    "k6",
    "gitleaks"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "duplicates": "off"
  },
  "workspaces": {
    ".": {
      "ignoreFiles": [
        "tools/contracts/**/*.mjs",
        "tools/guards/**/*.mjs",
        "tools/mobile/*.d.ts",
        "tools/performance/**/*.{js,cjs}",
        "tools/scripts/*.mjs",
        "tools/verification/**/*.mjs"
      ],
      "ignoreDependencies": [
        "expo-linking"
      ],
      "ignoreIssues": {
        "tools/guards/_guard-utils.mjs": [
          "exports"
        ],
        "tools/scripts/dsh-openapi-modular-lib.mjs": [
          "exports"
        ]
      }
    },
    "apps/app-client/runtime": {
      "entry": [
        "fingerprint.config.js"
      ],
      "ignoreDependencies": [
        "@bthwani/media-runtime",
        "@expo/fingerprint",
        "@tanstack/react-query",
        "expo-application",
        "expo-crypto",
        "expo-device",
        "expo-image",
        "expo-image-manipulator",
        "expo-localization"
      ]
    },
    "apps/app-partner/runtime": {
      "entry": [
        "fingerprint.config.js"
      ],
      "ignoreDependencies": [
        "@bthwani/media-runtime",
        "@expo/fingerprint",
        "@tanstack/react-query",
        "expo-application",
        "expo-crypto",
        "expo-device",
        "expo-image",
        "expo-image-manipulator",
        "expo-keep-awake",
        "expo-localization"
      ]
    },
    "apps/app-captain/runtime": {
      "entry": [
        "fingerprint.config.js"
      ],
      "ignoreDependencies": [
        "@bthwani/media-runtime",
        "@expo/fingerprint",
        "expo-application",
        "expo-battery",
        "expo-crypto",
        "expo-device",
        "expo-image",
        "expo-image-manipulator",
        "expo-keep-awake",
        "expo-localization"
      ]
    },
    "apps/app-field/runtime": {
      "entry": [
        "fingerprint.config.js"
      ],
      "ignoreDependencies": [
        "@bthwani/media-runtime",
        "@expo/fingerprint",
        "expo-application",
        "expo-battery",
        "expo-crypto",
        "expo-device",
        "expo-image",
        "expo-image-manipulator",
        "expo-localization"
      ]
    },
    "services/dsh": {
      "entry": [
        "contracts/contract-registry.ts",
        "runtime-map.ts",
        "service.manifest.ts",
        "frontend/app-*/index.{ts,tsx}",
        "frontend/app-*/**/index.{ts,tsx}",
        "frontend/app-*/**/*Surface.tsx",
        "frontend/app-*/**/*Screen.tsx",
        "frontend/app-*/**/*Panel.tsx",
        "frontend/app-*/**/*Sheet.tsx",
        "frontend/control-panel/**/index.{ts,tsx}",
        "frontend/control-panel/**/*Screen.tsx",
        "frontend/control-panel/**/*Panel.tsx",
        "frontend/shared/**/index.{ts,tsx}",
        "frontend/shared/**/*.registry.ts",
        "frontend/shared/**/*.contract.ts",
        "frontend/shared/**/*.policy.ts",
        "frontend/shared/**/*.view-model.ts",
        "frontend/shared/**/*.adapter.ts",
        "frontend/shared/**/*.transport.ts",
        "frontend/shared/**/*.state-machine.ts",
        "frontend/shared/**/*.states.ts",
        "frontend/shared/**/*.types.ts",
        "frontend/shared/**/*.model.ts",
        "frontend/shared/**/*.api.ts",
        "frontend/shared/**/*.client.ts"
      ],
      "ignoreFiles": [
        "frontend/shared/**/generated/**"
      ],
      "ignoreDependencies": [
        "expo-constants",
        "expo-crypto",
        "expo-notifications",
        "expo-secure-store"
      ],
      "ignoreIssues": {
        "frontend/shared/**/generated/**": [
          "exports",
          "types"
        ]
      }
    },
    "services/wlt": {
      "entry": [
        "service.manifest.ts",
        "frontend/shared/**/*.{ts,tsx}",
        "frontend/app-*/operational-surface.classification.ts",
        "frontend/control-panel/_skeleton-proof/*.tsx"
      ]
    },
    "shared/data-runtime": {
      "ignoreDependencies": [
        "expo-battery"
      ]
    },
    "shared/ui-kit": {
      "entry": [
        "src/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "react-native"
      ]
    },
    "core/identity": {
      "entry": [
        "clients/index.ts",
        "clients/index.js",
        "clients/use-identity-session.js"
      ]
    },
    "core/platform-control": {
      "entry": [
        "service.manifest.ts"
      ],
      "ignoreDependencies": [
        "react"
      ]
    },
    "core/providers": {
      "entry": [
        "service.manifest.ts"
      ],
      "ignoreDependencies": [
        "react"
      ]
    },
    "core/workforce": {
      "entry": [
        "service.manifest.ts"
      ],
      "ignoreDependencies": [
        "react"
      ]
    }
  }
}
