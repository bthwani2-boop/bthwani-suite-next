{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    ".cache/**",
    ".gocache*/**",
    ".gomodcache*/**",
    "infra/**",
    "governance/**",
    ".github/**",
    "**/clients/generated/**",
    "**/contracts/generated/**"
  ],
  "ignoreDependencies": [
    "@react-native-community/netinfo",
    "expo-battery",
    "expo-dev-client",
    "expo-splash-screen",
    "expo-system-ui",
    "expo-updates",
    "react-native-web",
    "@types/react",
    "@ast-grep/cli",
    "@redocly/cli",
    "autocannon",
    "babel-plugin-react-compiler",
    "size-limit"
  ],
  "ignoreBinaries": [
    "dev",
    "gh",
    "go",
    "gofmt",
    "pwsh",
    "where",
    "where.exe",
    "graphify",
    "k6",
    "gitleaks",
    "lean-ctx",
    "osv-scanner",
    "taskkill"
  ],
  "ignoreIssues": {
    "tools/mobile/runtime-shared/sentry-config.ts": [
      "files"
    ],
    "shared/data-runtime/src/BthwaniQueryProvider.native.tsx": [
      "files"
    ],
    "tools/mobile/metro.config.factory.cjs": [
      "unlisted"
    ],
    "apps/app-*/runtime/fingerprint.config.js": [
      "unlisted"
    ]
  },
  "ignoreExportsUsedInFile": true,
  "rules": {
    "duplicates": "off"
  },
  "workspaces": {
    ".": {
      "entry": [
        "tools/mobile/eas-build-mobile.mjs",
        "tools/mobile/upgrade-mobile-packages.mjs",
        "tools/mobile/defineBthwaniExpoApp.js",
        "tools/mobile/metro.config.factory.cjs",
        "tools/mobile/verify-eas-provider-inputs.mjs",
        "tools/mobile/verify-mobile-export.mjs",
        "tools/mobile/verify-mobile-source.mjs",
        "tools/mobile/mobile-dev-data.mjs",
        "tools/mobile/sentry-env.js",
        "tools/mobile/verify-mobile-native.mjs",
        "tools/guards/**/*.mjs",
        "tools/scripts/*.mjs",
        "tools/scripts/**/*.mjs",
        "tools/verification/**/*.mjs",
        "tools/dev/get-code.mjs",
        "tools/dev/local-dev-session-broker.mjs",
        "tools/dev/verify-local-identity-bootstrap.mjs"
      ],
      "project": [
        "tools/**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts}"
      ],
      "ignoreFiles": [
        "tools/mobile/*.d.ts",
        "tools/performance/**/*.{js,cjs}",
        "tools/verification/**/*.sh"
      ],
      "ignoreDependencies": [
        "expo-linking"
      ]
    },
    "apps/control-panel/runtime": {
      "entry": [
        "src/app/api/auth/_lib/server-config.ts"
      ]
    },
    "apps/app-client/runtime": {
      "entry": [
        "fingerprint.config.js"
      ],
      "ignoreDependencies": [
        "expo-font"
      ]
    },
    "apps/app-partner/runtime": {
      "entry": [
        "fingerprint.config.js"
      ],
      "ignoreDependencies": [
        "expo-font"
      ]
    },
    "apps/app-captain/runtime": {
      "entry": [
        "fingerprint.config.js"
      ],
      "ignoreDependencies": [
        "expo-font"
      ]
    },
    "apps/app-field/runtime": {
      "entry": [
        "fingerprint.config.js"
      ],
      "ignoreDependencies": [
        "expo-font"
      ]
    },
    "services/dsh": {
      "entry": [
        "service.manifest.ts",
        "tests/*.test.mjs"
      ],
      "ignoreFiles": [
        "frontend/shared/**/generated/**"
      ],
      "ignoreDependencies": [
        "expo-constants",
        "expo-crypto",
        "expo-document-picker",
        "expo-notifications",
        "expo-secure-store",
        "expo-video"
      ],
      "ignoreIssues": {
        "frontend/shared/**/generated/**": [
          "exports",
          "types"
        ]
      }
    },
    "services/wlt": {
      "entry": [
        "service.manifest.ts"
      ]
    },
    "shared/data-runtime": {
      "ignoreDependencies": [
        "expo-battery"
      ]
    },
    "shared/ui-kit": {
      "entry": [
        "src/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "react-native"
      ],
      "ignoreIssues": {
        "src/components/_shared.js": [
          "exports"
        ],
        "src/index.js": [
          "exports"
        ]
      }
    },
    "core/identity": {
      "entry": [
        "clients/index.ts",
        "clients/use-identity-session.ts"
      ]
    },
    "core/platform-control": {
      "entry": [
        "service.manifest.ts"
      ],
      "ignoreDependencies": [
        "react"
      ]
    },
    "core/providers": {
      "entry": [
        "service.manifest.ts"
      ],
      "ignoreDependencies": [
        "react"
      ]
    },
    "core/workforce": {
      "ignoreDependencies": [
        "react"
      ]
    }
  }
}