{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    ".cache/**",
    ".gocache*/**",
    ".gomodcache*/**",
    "tools/diagnostics/**",
    "services/dsh/evidence/**",
    "infra/**",
    "governance/**",
    ".github/**",
    "**/clients/generated/**",
    "**/contracts/generated/**"
  ],
  "ignoreDependencies": [
    "@react-native-community/netinfo",
    "expo-battery",
    "expo-dev-client",
    "expo-splash-screen",
    "expo-system-ui",
    "expo-updates",
    "react-native-web",
    "@expo/vector-icons",
    "@types/react",
    "@ast-grep/cli",
    "@redocly/cli",
    "@stoplight/spectral-cli",
    "autocannon",
    "babel-plugin-react-compiler",
    "dependency-cruiser",
    "markdownlint-cli2",
    "sherif",
    "size-limit"
  ],
  "ignoreBinaries": [
    "dev",
    "gh",
    "go",
    "pwsh",
    "graphify",
    "k6",
    "gitleaks",
    "lean-ctx",
    "osv-scanner",
    "taskkill"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "duplicates": "off"
  },
  "workspaces": {
    ".": {
      "entry": [
        "tools/mobile/eas-build-mobile.mjs",
        "tools/mobile/mobile-dev-data.mjs",
        "tools/mobile/sentry-env.js",
        "tools/mobile/verify-mobile-native.mjs",
        "tools/guards/**/*.mjs",
        "tools/scripts/*.mjs",
        "tools/scripts/**/*.mjs",
        "tools/verification/**/*.mjs",
        "tools/dev/get-code.mjs",
        "tools/dev/local-dev-session-broker.mjs",
        "tools/dev/verify-local-identity-bootstrap.mjs",
        "plans/diagnose-implementing/*.mjs"
      ],
      "ignoreFiles": [
        "tools/contracts/**/*.mjs",
        "tools/mobile/*.d.ts",
        "tools/performance/**/*.{js,cjs}",
        "tools/verification/**/*.sh"
      ],
      "ignoreDependencies": [
        "expo-linking"
      ]
    },
    "apps/control-panel/runtime": {
      "entry": [
        "src/app/api/auth/_lib/server-config.ts"
      ]
    },
    "apps/app-client/runtime": {
      "entry": [
        "fingerprint.config.js"
      ]
    },
    "apps/app-partner/runtime": {
      "entry": [
        "fingerprint.config.js"
      ]
    },
    "apps/app-captain/runtime": {
      "entry": [
        "fingerprint.config.js"
      ]
    },
    "apps/app-field/runtime": {
      "entry": [
        "fingerprint.config.js"
      ]
    },
    "services/dsh": {
      "entry": [
        "contracts/contract-registry.ts",
        "runtime-map.ts",
        "service.manifest.ts",
        "tests/*.test.mjs",
        "frontend/app-*/index.{ts,tsx}",
        "frontend/app-*/**/index.{ts,tsx}",
        "frontend/app-*/**/*Surface.tsx",
        "frontend/app-*/**/*Screen.tsx",
        "frontend/app-*/**/*Panel.tsx",
        "frontend/app-*/**/*Sheet.tsx",
        "frontend/app-*/**/*Header.tsx",
        "frontend/app-*/**/*context.tsx",
        "frontend/app-*/*.navigation-bridge.ts",
        "frontend/app-partner/account/PartnerHubNav.tsx",
        "frontend/app-partner/dsh-partner-binding.contracts.ts",
        "frontend/control-panel/**/index.{ts,tsx}",
        "frontend/control-panel/**/*Screen.tsx",
        "frontend/control-panel/**/*Panel.tsx",
        "frontend/control-panel/**/*View.tsx",
        "frontend/control-panel/**/*Inspector.tsx",
        "frontend/control-panel/**/*Workspace.tsx",
        "frontend/control-panel/**/*Section.tsx",
        "frontend/control-panel/**/*.types.ts",
        "frontend/control-panel/**/*.helpers.ts",
        "frontend/control-panel/finance/RepresentativeWalletLookup.tsx",
        "frontend/control-panel/hr/SupervisorPicker.tsx",
        "frontend/control-panel/hr/WorkforceScopeManager.tsx",
        "frontend/control-panel/hr/ZonePicker.tsx",
        "frontend/control-panel/platform/DshPlatformWorkspaces.tsx",
        "frontend/shared/**/index.{ts,tsx}",
        "frontend/shared/**/*.registry.ts",
        "frontend/shared/**/*contract*.ts",
        "frontend/shared/**/*.policy.ts",
        "frontend/shared/**/*.view-model.ts",
        "frontend/shared/**/*.adapter.ts",
        "frontend/shared/**/*.transport.ts",
        "frontend/shared/**/*.state-machine.ts",
        "frontend/shared/**/*.states.ts",
        "frontend/shared/**/*.types.ts",
        "frontend/shared/**/*.model.ts",
        "frontend/shared/**/*.api.ts",
        "frontend/shared/**/*.client.ts",
        "frontend/shared/**/*controller*.{ts,tsx}",
        "frontend/shared/**/*journey.ts",
        "frontend/shared/**/*classifier.ts",
        "frontend/shared/**/*image-source.ts",
        "frontend/shared/**/*notification-action.ts",
        "frontend/shared/_kernel/DshDevDiagnostic.tsx",
        "frontend/shared/operations/dsh-operational-runtime-adapter.ts",
        "frontend/shared/partner-delivery/PartnerDeliveryStatusCard.tsx",
        "frontend/shared/partner/operator-delivery-pricing.tsx",
        "frontend/shared/workforce/WorkforceErrorState.tsx"
      ],
      "ignoreFiles": [
        "frontend/shared/**/generated/**"
      ],
      "ignoreDependencies": [
        "expo-constants",
        "expo-crypto",
        "expo-document-picker",
        "expo-notifications",
        "expo-secure-store",
        "expo-video"
      ],
      "ignoreIssues": {
        "frontend/shared/**/generated/**": [
          "exports",
          "types"
        ]
      }
    },
    "services/wlt": {
      "entry": [
        "service.manifest.ts",
        "frontend/shared/**/*.{ts,tsx}",
        "frontend/app-*/operational-surface.classification.ts",
        "frontend/control-panel/_skeleton-proof/*.tsx"
      ]
    },
    "shared/data-runtime": {
      "ignoreDependencies": [
        "expo-battery"
      ]
    },
    "shared/ui-kit": {
      "entry": [
        "src/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "react-native"
      ],
      "ignoreIssues": {
        "src/components/_shared.js": [
          "exports"
        ],
        "src/index.js": [
          "exports"
        ]
      }
    },
    "core/identity": {
      "entry": [
        "clients/index.ts",
        "clients/use-identity-session.ts"
      ]
    },
    "core/platform-control": {
      "entry": [
        "service.manifest.ts"
      ],
      "ignoreDependencies": [
        "react"
      ]
    },
    "core/providers": {
      "entry": [
        "service.manifest.ts"
      ],
      "ignoreDependencies": [
        "react"
      ]
    },
    "core/workforce": {
      "ignoreDependencies": [
        "react"
      ]
    }
  }
}
