{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Flaky test registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "states", "rules", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "states": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "enum": ["STABLE", "FLAKY_SUSPECTED", "FLAKY_CONFIRMED", "QUARANTINED", "FIXED", "EXPIRED_QUARANTINE"] }
    },
    "rules": { "type": "array", "minItems": 8, "items": { "type": "string", "minLength": 10 } },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["testId", "path", "state", "owner", "firstObserved"],
        "properties": {
          "testId": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "state": { "enum": ["STABLE", "FLAKY_SUSPECTED", "FLAKY_CONFIRMED", "QUARANTINED", "FIXED", "EXPIRED_QUARANTINE"] },
          "owner": { "type": "string", "minLength": 1 },
          "firstObserved": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "quarantineExpiry": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "failureFingerprint": { "type": "string" },
          "taskId": { "type": "string", "pattern": "^GAP-[0-9]{4}$" },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
