{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BThwani Guard Sets",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policy", "guardSets", "journeyProfiles"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "noAllGuardsByDefault",
        "noFullLintByDefault",
        "noZipByDefault",
        "guardsVerifyOnly",
        "ciSourceMutationForbidden",
        "sameCommitEvidenceRequired"
      ],
      "properties": {
        "noAllGuardsByDefault": { "const": true },
        "noFullLintByDefault": { "const": true },
        "noZipByDefault": { "const": true },
        "guardsVerifyOnly": { "const": true },
        "ciSourceMutationForbidden": { "const": true },
        "sameCommitEvidenceRequired": { "const": true }
      }
    },
    "guardSets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["foundation", "journey", "governance"],
      "properties": {
        "foundation": { "$ref": "#/definitions/guardIds" },
        "journey": { "$ref": "#/definitions/guardIds" },
        "governance": { "$ref": "#/definitions/guardIds" }
      }
    },
    "journeyProfiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/definitions/guardIds"
      }
    }
  },
  "definitions": {
    "guardIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }
    }
  }
}
