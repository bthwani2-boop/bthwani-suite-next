{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BThwani Partner SaaS Capability Governance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "platformMode",
    "partnerSaasModel",
    "partnerAccessModel",
    "partnerOrganizationBoundary",
    "storeBoundary",
    "operatorContextPurpose",
    "trustedOperatorContextRequired",
    "clientSuppliedOperatorContextTrusted",
    "partnerCapabilities",
    "canonicalDecision",
    "decisionVocabulary"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "platformMode": { "const": "BTHWANI_NATIVE_PLATFORM" },
    "partnerSaasModel": { "const": "EMBEDDED_PLATFORM_CAPABILITY" },
    "partnerAccessModel": { "const": "MANAGED_B2B_PLATFORM_ACCESS" },
    "partnerOrganizationBoundary": { "const": "BUSINESS_SCOPE_NOT_TENANT" },
    "storeBoundary": { "const": "BUSINESS_SCOPE_NOT_TENANT" },
    "operatorContextPurpose": { "const": "TRUST_AND_DATA_ISOLATION" },
    "trustedOperatorContextRequired": { "const": true },
    "clientSuppliedOperatorContextTrusted": { "const": false },
    "partnerCapabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "canonicalDecision": {
      "enum": ["PASS", "FIX_REQUIRED", "BLOCKED_EXTERNAL", "NEEDS_EVIDENCE", "PROTOCOL_VIOLATION", "CLOSED_WITH_EVIDENCE"]
    },
    "decisionVocabulary": { "const": "governance/contracts/decision-vocabulary.json" }
  }
}
