{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Adaptive remediation policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "decision", "wipWriteLimit", "maxRepairIterations", "microLoopAttemptCap",
    "executorApproverSeparation", "failClosedDecision", "sameCommitEvidence", "archivalOverDeletion",
    "gitHistoryIsDefaultArchive", "persistentTaskStateRequired", "rawEvidenceInGitForbidden",
    "childBranchPattern", "mergeTarget", "masterMerge", "gitWriteAuthorization", "taskInstanceFormat",
    "liveLockRoot", "evidenceRoots", "autoChildMerge", "upstreamContracts",
    "registryDataIsProvisional", "diagnosisBeforeRemediationRequired", "diagnosisRequirementNote"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "decision": { "const": "ADAPTIVE_REMEDIATION_WITH_EPHEMERAL_EXECUTION_STATE" },
    "wipWriteLimit": { "const": 1 },
    "maxRepairIterations": { "const": 3 },
    "microLoopAttemptCap": { "const": 2 },
    "executorApproverSeparation": { "const": true },
    "failClosedDecision": { "const": "NEEDS_EVIDENCE" },
    "sameCommitEvidence": { "const": true },
    "archivalOverDeletion": { "const": false },
    "gitHistoryIsDefaultArchive": { "const": true },
    "persistentTaskStateRequired": { "const": false },
    "rawEvidenceInGitForbidden": { "const": true },
    "childBranchPattern": { "const": "task/<work-branch>/<task-id>-<slug>" },
    "mergeTarget": { "const": "work_branch_only" },
    "masterMerge": { "const": "human_explicit_command_only" },
    "gitWriteAuthorization": { "const": "human_explicit_command_per_round" },
    "taskInstanceFormat": { "const": "ephemeral_execution_context" },
    "liveLockRoot": { "const": ".diagnostics/remediation/locks/" },
    "evidenceRoots": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": { "enum": [".diagnostics/remediation/", "github-actions-artifact", "pull-request-or-check-summary"] },
      "allOf": [
        { "contains": { "const": ".diagnostics/remediation/" } },
        { "contains": { "const": "github-actions-artifact" } },
        { "contains": { "const": "pull-request-or-check-summary" } }
      ]
    },
    "autoChildMerge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "activationOwner", "activationBlockedBy", "requiredConditions"],
      "properties": {
        "enabled": { "const": false },
        "activationOwner": { "type": "string", "minLength": 1 },
        "activationBlockedBy": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "requiredConditions": { "type": "array", "minItems": 12, "maxItems": 12, "items": { "type": "string", "minLength": 10 } }
      }
    },
    "registryDataIsProvisional": { "const": true },
    "diagnosisBeforeRemediationRequired": { "const": true },
    "diagnosisRequirementNote": { "type": "string", "minLength": 20 },
    "upstreamContracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workUnitContract", "modelRoutingPolicy", "branchReturnPolicy", "retentionPolicy", "decisionVocabulary", "sdlcStateMachine"],
      "properties": {
        "workUnitContract": { "type": "string" },
        "modelRoutingPolicy": { "type": "string" },
        "branchReturnPolicy": { "type": "string" },
        "retentionPolicy": { "type": "string" },
        "decisionVocabulary": { "type": "string" },
        "sdlcStateMachine": { "type": "string" }
      }
    }
  }
}
