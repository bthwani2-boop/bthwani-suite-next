{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Gap ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gapTypes", "priorityOrder", "gaps"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "gapTypes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" } },
    "priorityOrder": { "type": "array", "minItems": 4, "items": { "type": "string" } },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gap_id", "type", "path", "owner", "affected_surface", "affected_journeys",
          "root_cause", "pattern_group", "risk_level", "required_action", "target_files",
          "allowed_decision", "forbidden_actions", "verification_commands", "proof_required",
          "status", "blocks_journey_start", "risk_class", "state", "verification_profile", "discovered_at"
        ],
        "properties": {
          "gap_id": { "type": "string", "pattern": "^GAP-[0-9]{4}$" },
          "type": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
          "path": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "affected_surface": { "type": "string", "minLength": 1 },
          "affected_journeys": { "type": "array", "items": { "type": "string" } },
          "root_cause": { "type": "string", "minLength": 5 },
          "pattern_group": { "type": "string", "minLength": 1 },
          "risk_level": { "enum": ["LOW", "FOCUSED", "STANDARD", "HIGH", "CRITICAL"] },
          "required_action": { "type": "string", "minLength": 5 },
          "target_files": { "type": "array", "items": { "type": "string" } },
          "allowed_decision": { "enum": ["PASS", "FIX_REQUIRED", "BLOCKED_EXTERNAL", "NEEDS_EVIDENCE", "READY_FOR_REVIEW", "PROTOCOL_VIOLATION", "CLOSED_WITH_EVIDENCE"] },
          "forbidden_actions": { "type": "array", "items": { "type": "string" } },
          "verification_commands": { "type": "array", "items": { "type": "string" } },
          "proof_required": { "type": "array", "items": { "type": "string" } },
          "status": { "enum": ["OPEN", "IN_PROGRESS", "CLOSED"] },
          "blocks_journey_start": { "type": "boolean" },
          "risk_class": { "enum": ["LOW", "FOCUSED", "STANDARD", "HIGH", "CRITICAL"] },
          "task_id": { "type": "string", "pattern": "^GAP-[0-9]{4}$" },
          "state": { "enum": ["DISCOVERED", "TRIAGED", "QUEUED", "DIAGNOSING", "BLOCKED", "CONTRACT_READY", "REPAIRING", "VERIFYING", "FIX_REQUIRED", "READY_TO_INTEGRATE", "INTEGRATING", "INTEGRATED", "CLEANING", "CLEANED", "RECONCILED", "CLOSED"] },
          "verification_profile": { "enum": ["STATIC_SCOPED", "TARGETED_TEST", "AFFECTED_BUILD", "RUNTIME_PROOF", "FULL_GATE"] },
          "blocked_reason": { "type": "string" },
          "priority": { "enum": ["P0", "P1", "P2", "P3"] },
          "discovered_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
