{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Blind spot registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["blindSpotId", "area", "statement", "mitigation", "reviewCadenceDays", "lastReviewed"],
        "properties": {
          "blindSpotId": { "type": "string", "pattern": "^BS-[0-9]{4}$" },
          "area": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 10 },
          "mitigation": { "type": "string", "minLength": 10 },
          "reviewCadenceDays": { "type": "integer", "minimum": 1, "maximum": 365 },
          "lastReviewed": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
        }
      }
    }
  }
}
