{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cleanup classification vocabulary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "archivalOverDeletion", "note", "cleanupClasses", "deadCodeClasses", "deadCodeProofSteps", "forbiddenAutomaticClasses", "moveBeforeArchiveProtocol", "retentionPolicy"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "archivalOverDeletion": { "const": true },
    "note": { "type": "string", "minLength": 20 },
    "cleanupClasses": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": { "enum": ["KEEP_CANONICAL", "MOVE", "MERGE", "RENAME", "GENERATE_INSTEAD", "ARCHIVE", "SAFE_DELETE", "REVIEWED_DELETE", "PROTECTED", "UNKNOWN_USAGE"] }
    },
    "deadCodeClasses": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": { "enum": ["DEAD_PROVEN", "DYNAMIC_USAGE", "GENERATED", "TEST_ONLY", "RUNTIME_ONLY", "UNKNOWN_USAGE", "KEEP"] }
    },
    "deadCodeProofSteps": { "type": "array", "minItems": 10, "maxItems": 10, "items": { "type": "string" } },
    "forbiddenAutomaticClasses": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "moveBeforeArchiveProtocol": { "type": "array", "minItems": 6, "maxItems": 6, "items": { "type": "string" } },
    "retentionPolicy": { "const": "governance/cleanup/repository-retention-policy.json" }
  }
}
