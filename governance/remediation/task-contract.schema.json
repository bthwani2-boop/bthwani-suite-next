{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Task contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "task", "source", "problem", "product", "behavior", "scope", "dependencies", "agents", "proof", "acceptance", "cleanup", "approval", "budget", "confidence"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "class", "priority", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^GAP-[0-9]{4}$" },
        "title": { "type": "string", "minLength": 1 },
        "class": { "enum": ["PRODUCT_BEHAVIOR", "CONTRACT", "BACKEND", "DATABASE", "FRONTEND", "RUNTIME", "SECURITY", "FINANCE", "TENANCY", "CLEANUP", "GOVERNANCE", "WORKFLOW", "DOCUMENTATION", "TEST_QUALITY"] },
        "priority": { "enum": ["P0", "P1", "P2", "P3"] },
        "status": { "enum": ["DISCOVERED", "TRIAGED", "QUEUED", "DIAGNOSING", "BLOCKED", "CONTRACT_READY", "REPAIRING", "VERIFYING", "FIX_REQUIRED", "READY_TO_INTEGRATE", "INTEGRATING", "INTEGRATED", "CLEANING", "CLEANED", "RECONCILED", "CLOSED"] }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "workBranch", "baseSha"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "workBranch": { "type": "string", "minLength": 1 },
        "baseSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "contractHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "frozenAt": { "type": "string", "format": "date-time" }
      }
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "evidenceState", "evidence", "rootCauseHypothesis"],
      "properties": {
        "statement": { "type": "string", "minLength": 10 },
        "evidenceState": { "enum": ["PROVEN", "NEEDS_EVIDENCE"] },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "lineRange": { "type": "string" },
              "note": { "type": "string" }
            }
          }
        },
        "rootCauseHypothesis": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["journey", "actors", "includedSurfaces", "excludedSurfaces"],
      "properties": {
        "journey": { "type": "string", "minLength": 1 },
        "actors": { "type": "array", "items": { "type": "string" } },
        "includedSurfaces": { "type": "array", "items": { "type": "string" } },
        "excludedSurfaces": { "type": "array", "items": { "type": "string" } }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "required", "forbidden"],
      "properties": {
        "current": { "type": "array", "items": { "type": "string" } },
        "required": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "forbidden": { "type": "array", "items": { "type": "string" } }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedPaths", "forbiddenPaths", "maximumChangedFiles", "maximumChangedLines"],
      "properties": {
        "allowedPaths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "forbiddenPaths": { "type": "array", "items": { "type": "string" } },
        "maximumChangedFiles": { "type": "integer", "minimum": 1, "maximum": 20 },
        "maximumChangedLines": { "type": "integer", "minimum": 1, "maximum": 800 }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blockedBy", "blocks", "sharedContracts", "sharedGeneratedOutputs"],
      "properties": {
        "blockedBy": { "type": "array", "items": { "type": "string" } },
        "blocks": { "type": "array", "items": { "type": "string" } },
        "sharedContracts": { "type": "array", "items": { "type": "string" } },
        "sharedGeneratedOutputs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "maximumRepairIterations", "roles"],
      "properties": {
        "required": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "maximumRepairIterations": { "type": "integer", "minimum": 1, "maximum": 3 },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["diagnosedBy", "executedBy", "reviewedBy"],
          "properties": {
            "diagnosedBy": { "type": "string", "minLength": 1 },
            "executedBy": { "type": "string", "minLength": 1 },
            "reviewedBy": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "workUnits": {
      "type": "array",
      "items": { "$ref": "work-unit.schema.json" }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "commands", "scenarios"],
      "properties": {
        "required": {
          "type": "object",
          "additionalProperties": false,
          "required": ["static", "contract", "unit", "integration", "database", "runtime", "visual", "native", "security", "tenancy", "performance", "resilience"],
          "properties": {
            "static": { "type": "boolean" },
            "contract": { "type": "boolean" },
            "unit": { "type": "boolean" },
            "integration": { "type": "boolean" },
            "database": { "type": "boolean" },
            "runtime": { "type": "boolean" },
            "visual": { "type": "boolean" },
            "native": { "type": "boolean" },
            "security": { "type": "boolean" },
            "tenancy": { "type": "boolean" },
            "performance": { "type": "boolean" },
            "resilience": { "type": "boolean" }
          }
        },
        "commands": { "type": "array", "items": { "type": "string" } },
        "scenarios": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "statement": { "type": "string" }
            }
          }
        }
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "evidenceRequired"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC-[0-9]{3}$" },
          "statement": { "type": "string", "minLength": 5 },
          "evidenceRequired": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temporaryPaths", "expectedArchivedPaths", "archivePaths"],
      "properties": {
        "temporaryPaths": { "type": "array", "items": { "type": "string" } },
        "expectedArchivedPaths": { "type": "array", "items": { "type": "string" } },
        "archivePaths": { "type": "array", "items": { "type": "string" } }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protectedDomains", "humanApprovalRequired"],
      "properties": {
        "protectedDomains": { "type": "array", "items": { "type": "string" } },
        "humanApprovalRequired": { "type": "boolean" }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxJobs", "maxRuntimeMinutes", "maxAgentIterations", "maxChangedFiles", "maxChangedLines", "maxArtifactsMb", "maxFullScans"],
      "properties": {
        "maxJobs": { "type": "integer", "minimum": 1, "maximum": 20 },
        "maxRuntimeMinutes": { "type": "integer", "minimum": 1, "maximum": 120 },
        "maxAgentIterations": { "type": "integer", "minimum": 1, "maximum": 3 },
        "maxChangedFiles": { "type": "integer", "minimum": 1, "maximum": 20 },
        "maxChangedLines": { "type": "integer", "minimum": 1, "maximum": 800 },
        "maxArtifactsMb": { "type": "integer", "minimum": 1, "maximum": 250 },
        "maxFullScans": { "type": "integer", "minimum": 0, "maximum": 1 }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productModel", "static", "contract", "database", "runtime", "visual", "native", "security", "tenancy", "finance", "performance", "resilience", "recovery"],
      "properties": {
        "productModel": { "$ref": "#/definitions/confidenceValue" },
        "static": { "$ref": "#/definitions/confidenceValue" },
        "contract": { "$ref": "#/definitions/confidenceValue" },
        "database": { "$ref": "#/definitions/confidenceValue" },
        "runtime": { "$ref": "#/definitions/confidenceValue" },
        "visual": { "$ref": "#/definitions/confidenceValue" },
        "native": { "$ref": "#/definitions/confidenceValue" },
        "security": { "$ref": "#/definitions/confidenceValue" },
        "tenancy": { "$ref": "#/definitions/confidenceValue" },
        "finance": { "$ref": "#/definitions/confidenceValue" },
        "performance": { "$ref": "#/definitions/confidenceValue" },
        "resilience": { "$ref": "#/definitions/confidenceValue" },
        "recovery": { "$ref": "#/definitions/confidenceValue" }
      }
    }
  },
  "definitions": {
    "confidenceValue": { "enum": ["PROVEN", "NEEDS_EVIDENCE", "NOT_APPLICABLE"] }
  }
}
