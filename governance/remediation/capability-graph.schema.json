{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Product model graph (nodes are product_model_node entries; populated progressively in wave P1-A)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "population", "chain", "surfaces", "surfaceElements", "nodes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "population": { "enum": ["PROGRESSIVE_P1A", "POPULATED"] },
    "chain": { "type": "array", "minItems": 17, "maxItems": 17, "uniqueItems": true, "items": { "type": "string" } },
    "surfaces": { "type": "array", "minItems": 15, "maxItems": 15, "uniqueItems": true, "items": { "type": "string" } },
    "surfaceElements": { "type": "array", "minItems": 14, "maxItems": 14, "uniqueItems": true, "items": { "type": "string" } },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nodeId", "kind", "domain", "journey", "surface"],
        "properties": {
          "nodeId": { "type": "string", "minLength": 1 },
          "kind": { "const": "product_model_node" },
          "domain": { "type": "string", "minLength": 1 },
          "journey": { "type": "string", "minLength": 1 },
          "actor": { "type": "string" },
          "surface": { "type": "string", "minLength": 1 },
          "chainBindings": { "type": "object", "additionalProperties": { "type": "string" } },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "gapIds": { "type": "array", "items": { "type": "string", "pattern": "^GAP-[0-9]{4}$" } }
        }
      }
    }
  }
}
