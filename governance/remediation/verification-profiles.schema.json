{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Verification profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "dimensions", "profiles"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "dimensions": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "activation"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z_]+$" },
          "activation": { "enum": ["ACTIVE", "PLANNED"] },
          "plannedWave": { "type": "string", "pattern": "^(P1-[A-D]|P2|R)$" }
        }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "guardIds", "commands", "dimensions"],
        "properties": {
          "id": { "enum": ["STATIC_SCOPED", "TARGETED_TEST", "AFFECTED_BUILD", "RUNTIME_PROOF", "FULL_GATE"] },
          "description": { "type": "string", "minLength": 1 },
          "guardIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "commands": { "type": "array", "items": { "type": "string" } },
          "dimensions": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    }
  }
}
