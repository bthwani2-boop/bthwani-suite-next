{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Work unit assignment (verbatim projection of .agents/skills/bthwani-cost-aware-subagent-orchestrator/references/WORK_UNIT_CONTRACT.md; the remediation gate fails on drift)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "work_unit_id", "title", "role", "objective", "dependencies", "risk_level",
    "capability_tier", "execution_mode", "allowed_read_paths", "allowed_write_paths",
    "forbidden_paths", "required_context", "required_skills", "acceptance_criteria",
    "verification_commands", "output_budget", "escalation_conditions"
  ],
  "properties": {
    "work_unit_id": { "type": "string", "pattern": "^(GAP-[0-9]{4}-)?WU-[0-9]{3}$" },
    "title": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "pattern": "^[A-Z][A-Z_]+$" },
    "objective": { "type": "string", "minLength": 1 },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "risk_level": { "enum": ["LOW", "FOCUSED", "STANDARD", "HIGH", "CRITICAL"] },
    "capability_tier": { "enum": ["T0_MINIMAL", "T1_BALANCED", "T2_SPECIALIST", "T3_ADVISORY_MAX"] },
    "execution_mode": { "enum": ["READ_ONLY", "WRITE"] },
    "allowed_read_paths": { "type": "array", "items": { "type": "string" } },
    "allowed_write_paths": { "type": "array", "items": { "type": "string" } },
    "forbidden_paths": { "type": "array", "items": { "type": "string" } },
    "required_context": { "type": "array", "items": { "type": "string" } },
    "required_skills": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "verification_commands": { "type": "array", "items": { "type": "string" } },
    "output_budget": { "const": "COMPACT" },
    "escalation_conditions": { "type": "array", "items": { "type": "string" } }
  }
}
