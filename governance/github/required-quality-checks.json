    {"context":"SonarCloud Code Analysis","producer":"sonarqubecloud","purpose":"SonarQube Cloud Quality Gate result."},
    {"context":"Analyze actions","producer":"github-actions","purpose":"CodeQL analysis of GitHub Actions workflow code."},
    {"context":"Analyze javascript-typescript","producer":"github-actions","purpose":"CodeQL analysis of JavaScript and TypeScript."},
    {"context":"Analyze go (dsh)","producer":"github-actions","purpose":"CodeQL analysis of DSH Go backend."},
    {"context":"Analyze go (identity)","producer":"github-actions","purpose":"CodeQL analysis of Identity Go backend."},
    {"context":"Analyze go (platform-control)","producer":"github-actions","purpose":"CodeQL analysis of Platform Control Go backend."},
    {"context":"Analyze go (providers)","producer":"github-actions","purpose":"CodeQL analysis of Providers Go backend."},
    {"context":"Analyze go (wlt)","producer":"github-actions","purpose":"CodeQL analysis of WLT Go backend."},
    {"context":"Analyze go (workforce)","producer":"github-actions","purpose":"CodeQL analysis of Workforce Go backend."},
    {"context":"Dependency review","producer":"github-actions","purpose":"Blocks newly introduced dependencies with known vulnerabilities."}
  ]
