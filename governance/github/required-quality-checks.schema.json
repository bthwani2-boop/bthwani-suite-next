{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Required quality checks registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "baseBranch", "rulesetName", "requiredChecks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "baseBranch": { "type": "string", "minLength": 1 },
    "rulesetName": { "type": "string", "minLength": 1 },
    "requiredChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["context", "producer", "purpose"],
        "properties": {
          "context": { "type": "string", "minLength": 1 },
          "producer": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "purpose": { "type": "string", "minLength": 10 }
        }
      }
    }
  }
}
