{
  "schemaVersion": 1,
  "status": "ACTIVE_CANONICAL",
  "effectiveDate": "2026-07-26",
  "policyId": "DIRECT_WORK_BRANCH_EXECUTION",
  "authorityDomains": [
    "branch_execution",
    "repository_writes",
    "task_routing"
  ],
  "defaultMode": {
    "sourceBranch": "USER_NAMED_WORK_BRANCH",
    "targetBranch": "SAME_AS_SOURCE",
    "createTaskBranch": false,
    "createPullRequest": false,
    "mergeAutomatically": false
  },
  "rules": {
    "requireExplicitImplementationInstruction": true,
    "pinExactBranchShaBeforeWrite": true,
    "conditionalWriteAgainstCurrentFileOrBranchSha": true,
    "rePinBranchAfterFinalWrite": true,
    "verifyOnSameBranch": true,
    "minimizeLogicalWriteBatches": true,
    "neverSubstituteDefaultBranch": true,
    "neverForcePush": true,
    "neverOverwriteConcurrentMovement": true
  },
  "branchCreation": {
    "allowedByDefault": false,
    "allowedOnlyWhen": [
      "CURRENT_TASK_EXPLICITLY_REQUESTS_BRANCH_CREATION",
      "CURRENT_TASK_EXPLICITLY_REQUESTS_PULL_REQUEST"
    ],
    "protectedBranchFallback": "BLOCKED_EXTERNAL_UNTIL_EXPLICIT_HUMAN_ALTERNATIVE"
  },
  "highRiskWork": {
    "requiresAutomaticTaskBranch": false,
    "requiresRiskProportionalVerification": true,
    "protectedDomains": [
      "authentication",
      "authorization",
      "secrets",
      "tenant_isolation",
      "finance",
      "database_migrations",
      "ci",
      "infrastructure",
      "release",
      "production"
    ]
  },
  "forbidden": [
    "AUTOMATIC_TASK_BRANCH",
    "AUTOMATIC_PULL_REQUEST",
    "AUTOMATIC_TARGET_BRANCH_SUBSTITUTION",
    "HISTORICAL_BLANKET_APPROVAL_AS_BRANCH_CREATION_AUTHORITY",
    "FORCE_PUSH",
    "STALE_SHA_OVERWRITE"
  ],
  "humanReadablePolicy": "governance/policies/release.md"
}
