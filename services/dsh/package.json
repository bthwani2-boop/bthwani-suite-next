{
  "name": "@bthwani/dsh",
  "type": "module",
  "description": "BThwani DSH service workspace.",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "openapi:compose": "node ../../tools/scripts/compose-openapi-context.mjs dsh",
    "openapi:generate": "node -e \"require('node:fs').mkdirSync('clients/generated',{recursive:true})\" && pnpm run openapi:compose && pnpm exec openapi-typescript contracts/generated/dsh.bundle.openapi.yaml -o clients/generated/dsh-api.ts",
    "openapi:test": "node --test tests/dsh-openapi-modular.test.mjs",
    "openapi:verify": "node ../../tools/guards/dsh-openapi-modular-gate.mjs",
    "database:migrate": "pwsh -NoProfile -ExecutionPolicy Bypass -File database/scripts/invoke-dsh-database.ps1 -Action migrate -Transport auto",
    "database:seed:local": "pwsh -NoProfile -ExecutionPolicy Bypass -File database/scripts/invoke-dsh-database.ps1 -Action seed -Transport auto -AllowLocalSeeds",
    "database:test": "pwsh -NoProfile -ExecutionPolicy Bypass -File database/scripts/invoke-dsh-database.ps1 -Action test -Transport auto -TestSuite schema",
    "database:test:seed": "pwsh -NoProfile -ExecutionPolicy Bypass -File database/scripts/invoke-dsh-database.ps1 -Action test -Transport auto -TestSuite seed",
    "database:contract": "node ../../tools/scripts/check-dsh-database-contract.mjs",
    "platform:boundary": "node ../../tools/guards/dsh-platform-boundary-gate.mjs",
    "data-provider:quarantine": "node ../../tools/guards/dsh-data-provider-quarantine-gate.mjs",
    "native-dependency:inventory": "node ../../tools/guards/dsh-native-dependency-inventory-gate.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').writeFileSync('dist/package.json', JSON.stringify({type:'commonjs'}))\" && node ../../tools/scripts/verify-go-build.mjs backend",
    "test": "pnpm --dir ../.. exec node --test services/dsh/tests/*.test.mjs",
    "lint": "pnpm run platform:boundary && pnpm run data-provider:quarantine && pnpm run native-dependency:inventory && pnpm --dir ../.. run guard:fullstack-boundary"
  },
  "peerDependencies": {
    "expo-document-picker": "~56.0.4",
    "expo-video": "~56.1.4",
    "react": "19.2.3"
  },
  "peerDependenciesMeta": {
    "expo-document-picker": {
      "optional": true
    },
    "expo-video": {
      "optional": true
    }
  },
  "dependencies": {
    "@bthwani/control-panel": "workspace:*",
    "@bthwani/core-identity": "workspace:*",
    "@bthwani/core-platform-control": "workspace:*",
    "@bthwani/core-providers": "workspace:*",
    "@bthwani/data-runtime": "workspace:*",
    "@bthwani/ui-kit": "workspace:*",
    "@bthwani/wlt": "workspace:*",
    "@react-native-async-storage/async-storage": "1.24.0",
    "@react-native-community/netinfo": "11.4.1",
    "expo-constants": "~56.0.22",
    "expo-crypto": "~56.0.4",
    "expo-image-picker": "~56.0.22",
    "expo-location": "~56.0.22",
    "expo-notifications": "~56.0.22",
    "expo-secure-store": "~56.0.4",
    "react-native": "0.85.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.17",
    "next": "^16.2.11",
    "react": "19.2.3",
    "typescript": "7.0.2"
  },
  "x-bthwani-platform-boundary": {
    "status": "LEGACY_MIXED_PACKAGE_QUARANTINE",
    "target": "PLATFORM_NEUTRAL_CORE_WITH_EXPLICIT_WEB_AND_MOBILE_ADAPTERS",
    "canonicalNativeDependencyOwner": "apps/*/runtime",
    "webRoot": "frontend/control-panel",
    "mobileRoots": [
      "frontend/app-client",
      "frontend/app-partner",
      "frontend/app-captain",
      "frontend/app-field"
    ],
    "sharedPlatformRoots": {
      "web": "frontend/shared/platform/web",
      "mobile": "frontend/shared/platform/mobile"
    },
    "legacyNativeDependencyQuarantine": [
      "@react-native-async-storage/async-storage",
      "@react-native-community/netinfo",
      "expo-constants",
      "expo-crypto",
      "expo-document-picker",
      "expo-image-picker",
      "expo-location",
      "expo-notifications",
      "expo-secure-store",
      "expo-video",
      "react-native",
      "react-native-maps",
      "react-native-safe-area-context",
      "react-native-svg"
    ],
    "dataRuntimeLegacyQuarantine": {
      "@react-native-async-storage/async-storage": {
        "currentVersion": "1.24.0",
        "canonicalVersion": "2.2.0",
        "target": "REMOVE_FROM_DSH_ROOT_AFTER_CONSUMER_MIGRATION"
      },
      "@react-native-community/netinfo": {
        "currentVersion": "11.4.1",
        "canonicalVersion": "12.0.1",
        "target": "REMOVE_FROM_DSH_ROOT_AFTER_CONSUMER_MIGRATION"
      }
    },
    "nativeDependencyReview": {
      "@react-native-async-storage/async-storage": {
        "status": "LEGACY_DATA_PROVIDER_QUARANTINE",
        "deletionAuthorized": false
      },
      "@react-native-community/netinfo": {
        "status": "LEGACY_DATA_PROVIDER_QUARANTINE",
        "deletionAuthorized": false
      },
      "expo-constants": {
        "status": "ACTIVE_DIRECT_CONSUMER",
        "evidence": ["services/dsh/frontend/shared/notifications/use-mobile-push-registration.ts"],
        "deletionAuthorized": false
      },
      "expo-crypto": {
        "status": "ACTIVE_DIRECT_CONSUMER",
        "evidence": ["services/dsh/frontend/shared/notifications/use-mobile-push-registration.ts"],
        "deletionAuthorized": false
      },
      "expo-document-picker": {
        "status": "ACTIVE_DIRECT_CONSUMER",
        "evidence": ["services/dsh/frontend/app-field/onboarding/DshFieldOnboardingScreen.tsx"],
        "deletionAuthorized": false
      },
      "expo-image-picker": {
        "status": "ACTIVE_DIRECT_CONSUMER",
        "evidence": ["services/dsh/frontend/app-partner/catalog/ProductMediaScreen.tsx"],
        "deletionAuthorized": false
      },
      "expo-location": {
        "status": "ACTIVE_DIRECT_CONSUMER",
        "evidence": ["services/dsh/frontend/app-client/account/AddressLocationScreen.tsx"],
        "deletionAuthorized": false
      },
      "expo-notifications": {
        "status": "ACTIVE_DIRECT_CONSUMER",
        "evidence": ["services/dsh/frontend/shared/notifications/use-mobile-push-registration.ts"],
        "deletionAuthorized": false
      },
      "expo-secure-store": {
        "status": "ACTIVE_DIRECT_CONSUMER",
        "evidence": ["services/dsh/frontend/shared/notifications/use-mobile-push-registration.ts"],
        "deletionAuthorized": false
      },
      "expo-video": {
        "status": "ACTIVE_DIRECT_CONSUMER",
        "evidence": ["services/dsh/frontend/app-client/home-discovery/HomeReelsSection.tsx"],
        "deletionAuthorized": false
      },
      "react-native": {
        "status": "ACTIVE_DIRECT_CONSUMER",
        "evidence": ["services/dsh/frontend/app-partner/catalog/ProductMediaScreen.tsx"],
        "deletionAuthorized": false
      },
      "react-native-maps": {
        "status": "ACTIVE_DIRECT_CONSUMER",
        "evidence": ["services/dsh/frontend/shared/maps/BthwaniNativeMap.tsx"],
        "deletionAuthorized": false
      },
      "react-native-safe-area-context": {
        "status": "ACTIVE_DIRECT_CONSUMER",
        "evidence": ["services/dsh/frontend/app-client/DshClientSurface.tsx"],
        "deletionAuthorized": false
      },
      "react-native-svg": {
        "status": "ACTIVE_DIRECT_CONSUMER",
        "evidence": ["services/dsh/frontend/app-client/shared/ui/Icons.tsx"],
        "deletionAuthorized": false
      }
    },
    "cleanupPolicy": "Do not add native dependencies here. Migrate consumers to explicit mobile adapters and remove quarantined dependencies only after exact-ref consumer, lockfile, Metro, typecheck, and fresh native-build evidence."
  },
  "exports": {
    "./control-panel": "./frontend/control-panel/index.ts",
    "./control-panel/finance": "./frontend/control-panel/finance/index.ts",
    "./control-panel/navigation": "./frontend/control-panel/navigation.ts",
    "./control-panel/session": "./frontend/control-panel/session.ts",
    "./control-panel/administration": "./frontend/control-panel/administration/index.ts",
    "./control-panel/analytics": "./frontend/control-panel/analytics/index.ts",
    "./control-panel/catalogs": "./frontend/control-panel/catalogs/index.ts",
    "./control-panel/dashboard": "./frontend/control-panel/dashboard/index.ts",
    "./control-panel/hr": "./frontend/control-panel/hr/index.ts",
    "./control-panel/marketing": "./frontend/control-panel/marketing/index.ts",
    "./control-panel/operations": "./frontend/control-panel/operations/index.ts",
    "./control-panel/partners": "./frontend/control-panel/partners/index.ts",
    "./control-panel/partners/stores": "./frontend/control-panel/partners/stores/index.ts",
    "./control-panel/platform": "./frontend/control-panel/platform/index.ts",
    "./control-panel/support": "./frontend/control-panel/support/index.ts"
  }
}
