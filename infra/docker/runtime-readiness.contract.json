{
  "schemaVersion": 1,
  "profiles": {
    "identity": {
      "name": "Identity API",
      "kind": "json-status",
      "baseUrlEnv": "IDENTITY_API_BASE_URL",
      "defaultBaseUrl": "http://127.0.0.1:58082",
      "path": "/identity/readiness",
      "healthyStatuses": ["HEALTHY"]
    },
    "workforce": {
      "name": "Workforce API",
      "kind": "json-status",
      "baseUrlEnv": "WORKFORCE_API_BASE_URL",
      "defaultBaseUrl": "http://127.0.0.1:58086",
      "path": "/workforce/readiness",
      "healthyStatuses": ["ready"]
    },
    "dsh": {
      "name": "DSH API",
      "kind": "json-status",
      "baseUrlEnv": "DSH_API_BASE_URL",
      "defaultBaseUrl": "http://127.0.0.1:58080",
      "path": "/dsh/readiness",
      "healthyStatuses": ["HEALTHY"]
    },
    "wlt": {
      "name": "WLT API",
      "kind": "json-status",
      "baseUrlEnv": "WLT_API_BASE_URL",
      "defaultBaseUrl": "http://127.0.0.1:58083",
      "path": "/wlt/readiness",
      "healthyStatuses": ["ready"]
    },
    "providers": {
      "name": "Providers API",
      "kind": "json-status",
      "baseUrlEnv": "PROVIDERS_API_BASE_URL",
      "defaultBaseUrl": "http://127.0.0.1:58087",
      "path": "/providers/readiness",
      "healthyStatuses": ["HEALTHY"]
    },
    "platform": {
      "name": "Platform Control API",
      "kind": "json-status",
      "baseUrlEnv": "PLATFORM_CONTROL_API_BASE_URL",
      "defaultBaseUrl": "http://127.0.0.1:58088",
      "path": "/platform/readiness",
      "healthyStatuses": ["HEALTHY"]
    },
    "media-storage": {
      "name": "MinIO",
      "kind": "http-ok",
      "host": "127.0.0.1",
      "portEnv": "BTHWANI_MINIO_API_PORT",
      "defaultPort": 59000,
      "path": "/minio/health/ready"
    }
  },
  "bundles": {
    "frontendDefault": ["identity", "dsh"],
    "mobileDevelopment": ["identity", "workforce", "dsh", "wlt", "media-storage"],
    "controlPanelDevelopment": ["identity", "workforce", "dsh", "wlt", "providers", "platform"]
  }
}
