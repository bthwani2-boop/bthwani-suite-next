# Identity Runtime Environment — reserved, not active

IDENTITY_RUNTIME_STATE=RESERVED_NOT_ACTIVE
IDENTITY_CONTAINER_NAME=bthwani-identity-api-runtime
IDENTITY_HOST_PORT=18082
IDENTITY_INTERNAL_PORT=8082
IDENTITY_DATABASE_URL=postgres://identity_runtime:identity_runtime_password@postgres:5432/identity_runtime?sslmode=disable

# Local development actors are created only by the explicit
# infra/docker/compose.dev-bootstrap.yml one-shot service. This runtime env
# example intentionally contains no bootstrap switch or password.

IDENTITY_ACTIVATION_HMAC_SECRET=LOCAL_ONLY_replace_with_32_plus_byte_activation_hmac_secret

# IDENTITY_CORS_ALLOWED_ORIGINS=https://control-panel.example.com,https://admin.example.com
# comma-separated allowlist of browser origins permitted to call this
# service directly (control-panel BFF calls are server-to-server and are
# not subject to CORS). Falls back to http://localhost:13000 only when unset.

# Activation gate:
# core identity backend Dockerfile + /health + /ready + auth/session smoke
