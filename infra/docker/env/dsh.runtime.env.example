# DSH Runtime Environment — reserved, not active

DSH_RUNTIME_STATE=RESERVED_NOT_ACTIVE
DSH_CONTAINER_NAME=bthwani-dsh-api-runtime
DSH_HOST_PORT=58080
DSH_INTERNAL_PORT=8080
DSH_DATABASE_URL=postgres://dsh_runtime:dsh_runtime_password@postgres:5432/dsh_runtime?sslmode=disable
DSH_IDENTITY_BASE_URL=http://identity-api:8082
# Must match Identity's IDENTITY_DSH_SERVICE_TOKEN. Replace outside local development.
DSH_IDENTITY_SERVICE_TOKEN=LOCAL_ONLY_replace_with_dsh_identity_internal_service_token
# Server-owned platform scope; never accept this value from a client payload.
BTHWANI_OPERATOR_CONTEXT_ID=local-dsh

# Activation gate:
# backend Dockerfile + /health + /ready + migration + seed + API smoke