# Copy this file to infra/local/control-panel.google.env.
# The target file is ignored by Git. Never commit the real Google Maps key.
#
# Provision/update the governed local browser key with:
# & .\tools\scripts\google-cloud\create-browser-maps-api-key.ps1 `
#   -ProjectId "bthwani-platform" `
#   -AllowedReferrers @("http://localhost:13000/*", "http://127.0.0.1:13000/*") `
#   -WriteEnvironmentFile ".\infra\local\control-panel.google.env"

NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_API_KEY=
