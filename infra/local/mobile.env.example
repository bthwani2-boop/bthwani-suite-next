# Copy this file to infra/local/mobile.env. The target file is ignored by Git.
# Never commit real DSNs, auth tokens, Firebase files, map keys, or provider credentials.

# Canonical mobile development transport.
# auto = default; try trusted LAN first and use Android ADB only when the target permits it.
# lan  = require the governed BThwani Mobile Dev Gateway; no ADB dependency.
# adb  = explicit Android-only USB/Wireless-ADB transport with verified reverse mappings.
BTHWANI_MOBILE_TRANSPORT=auto

# Canonical platform intent for transport fallback semantics.
# auto    = platform-neutral while LAN works; on macOS a failed LAN requires an explicit target.
# android = permits ADB fallback when auto transport cannot resolve trusted LAN.
# ios     = LAN only; iOS never falls back to ADB.
BTHWANI_MOBILE_PLATFORM=auto

# Optional deterministic LAN override for VPN/multi-adapter machines.
# Must be an RFC1918 IPv4 address assigned to this development machine.
BTHWANI_MOBILE_LAN_HOST=

# Public Windows network profiles are rejected by default. Leave disabled on
# normal trusted development networks; use only as an explicit one-run override.
BTHWANI_MOBILE_ALLOW_PUBLIC_NETWORK=0

# Shared Sentry organization. Sentry is optional for local development and does
# not block Android or iOS development. SENTRY_AUTH_TOKEN is used only for source-map upload.
SENTRY_ORG=
SENTRY_URL=https://sentry.io/
SENTRY_AUTH_TOKEN=

# One Sentry project and public DSN per mobile application.
SENTRY_PROJECT_APP_CLIENT=
EXPO_PUBLIC_SENTRY_DSN_APP_CLIENT=

SENTRY_PROJECT_APP_PARTNER=
EXPO_PUBLIC_SENTRY_DSN_APP_PARTNER=

SENTRY_PROJECT_APP_CAPTAIN=
EXPO_PUBLIC_SENTRY_DSN_APP_CAPTAIN=

SENTRY_PROJECT_APP_FIELD=
EXPO_PUBLIC_SENTRY_DSN_APP_FIELD=

EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
EXPO_PUBLIC_SENTRY_DEBUG=false
EXPO_PUBLIC_SENTRY_STARTUP_PROBE=false

# Firebase configuration is generated and validated by:
# pnpm mobile:eas -- -App <app-key> -Mode Initialize
# These optional overrides are only for deliberately managed external files.
GOOGLE_SERVICES_JSON_APP_CLIENT=
GOOGLE_SERVICES_JSON_APP_PARTNER=
GOOGLE_SERVICES_JSON_APP_CAPTAIN=
GOOGLE_SERVICES_JSON_APP_FIELD=

# Every mobile app declares the native maps capability. Initialize creates one
# Android Maps key per app, restricted to its package name and signing SHA-1.
GOOGLE_MAPS_ANDROID_API_KEY_APP_CLIENT=
GOOGLE_MAPS_ANDROID_API_KEY_APP_PARTNER=
GOOGLE_MAPS_ANDROID_API_KEY_APP_CAPTAIN=
GOOGLE_MAPS_ANDROID_API_KEY_APP_FIELD=

# Backend startup is automatic by default. Set to 0 only when services are
# deliberately managed in a separate terminal. Backend lifecycle remains owned
# by apps/mobile/ensure-mobile-dev-runtime.ps1, not by the transport launcher.
BTHWANI_AUTO_START_BACKEND=1
