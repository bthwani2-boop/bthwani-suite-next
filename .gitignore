node_modules/
.pnpm-store/

# Documentation and text files remain trackable. Graphify-specific exclusions
# belong exclusively in .graphifyignore.
*.pdf
*.zip
*.7z
*.rar
*.tar
*.gz

.env
.env.*
!.env.example
infra/local/*.env
secrets.local.mobile.json
tools/scripts/google-cloud/google-platform-input.local.json
apps/*/runtime/google-services.json
apps/*/runtime/credentials.json
.tmp/
dist/
dist-swagger/
build/
.next/
.expo/
coverage/
*.tsbuildinfo
.DS_Store
Thumbs.db

graphify-out/
.graphify/

.nx/cache/
.nx/workspace-data/

# Local images only
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.svg
*.ico
!services/dsh/evidence/**/*.png
services/dsh/evidence/DSH-002-home-discovery-fullstack/screenshots/
services/dsh/database/seeds/local/media/
!services/dsh/database/seeds/local/media/fixtures/
!services/dsh/database/seeds/local/media/fixtures/**

# Native application identity assets are governed source inputs for Expo/EAS.
!apps/*/runtime/assets/
!apps/*/runtime/assets/**

.gocache*/
.gomodcache*/
.cache/

# BTHWANI YAGNI / smallest-diff outputs
.yagni-out/

# Agent local state
.aider*
!.aiderignore

# Allow only bounded summaries/inventories/manifests inside .diagnostics
!.diagnostics/
.diagnostics/*
!.diagnostics/operational-journey-factory/
.diagnostics/operational-journey-factory/*
.diagnostics/operational-journey-factory/tool-evidence/
!.diagnostics/operational-journey-factory/inventories/
!.diagnostics/operational-journey-factory/inventories/*
!.diagnostics/operational-journey-factory/*.json
!.diagnostics/operational-journey-factory/*.md
!.diagnostics/operational-journey-factory/*.mjs
# Raw diagnostic outputs must never be tracked (reconciliation gate policy)
.diagnostics/operational-journey-factory/command-results.json
.diagnostics/operational-journey-factory/knip-current.json
tools/diagnostics/graph.json
tools/diagnostics/*.raw.json
tools/diagnostics/*.full.json
tools/diagnostics/knip-report.json
*.log
node-gates*.log
*_HANDOFF.zip
.claude/settings.local.json

# Generated Swagger / OpenAPI bundles
*.bundled.json

# Explicitly track bthwani-deep-diagnostic-input.md
!tools/diagnostics/bthwani-deep-diagnostic-input.md

# Explicitly track TOOLS_SETUP.md
!tools/diagnostics/TOOLS_SETUP.md

# Explicitly track all files in the governance directory
!governance/
!governance/**

# Explicitly track all files in the agent-system SSOT directory (.agents is the
# single source of truth for skills, routing, and archived agent-system material —
# see .agents/BTHWANI_HARNESS_PATTERNS.md)
!.agents/
!.agents/**

# Markdown and text files are tracked by default. No repository-wide unignore
# mirrors are required; .graphifyignore owns Graphify corpus exclusions.

# Explicitly track operational journey checklist
!tools/checklist/operational-journey-factory-checklist.md
!tools/checklist/**/

# Explicitly track diagnostic scripts
!tools/diagnostics/scripts/*.mjs

# Explicitly track bthwani prompts
!tools/prompts/

# Explicitly track the WLT Minimum Viable Financial Scope v1 governance doc
!services/wlt/FINANCIAL_SCOPE_V1.md

*.pem
*.key
*.p8
*.p12
