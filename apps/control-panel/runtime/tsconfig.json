{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@bthwani/ui-kit": ["shared/ui-kit/src/index.ts"],
      "@bthwani/ui-kit/web": ["shared/ui-kit/src/web.ts"],
      "@bthwani/ui-kit/tokens": ["shared/ui-kit/src/tokens/index.ts"],
      "@bthwani/app-shell": ["shared/app-shell/src/index.ts"],
      "@bthwani/data-runtime": ["shared/data-runtime/src/index.ts"],
      "@bthwani/media-runtime": ["shared/media-runtime/src/index.ts"],
      "@bthwani/core-identity": ["core/identity/clients/index.ts"],
      "@bthwani/core-identity/server": ["core/identity/clients/identity-client.ts"],
      "@bthwani/core-platform-control": ["core/platform-control/clients/generated/platform-control-api.ts"],
      "@bthwani/core-platform-control/*": ["core/platform-control/*"],
      "@bthwani/core-providers": ["core/providers/clients/generated/providers-api.ts"],
      "@bthwani/app-captain-runtime": ["apps/app-captain/runtime/src/index.ts"],
      "@bthwani/app-client-runtime": ["apps/app-client/runtime/src/index.ts"],
      "@bthwani/app-field-runtime": ["apps/app-field/runtime/src/index.ts"],
      "@bthwani/app-partner-runtime": ["apps/app-partner/runtime/src/index.ts"],
      "react-native": ["services/dsh/node_modules/react-native"],
      "react-native-maps": ["services/dsh/node_modules/react-native-maps"],
      "@tanstack/react-query": ["services/dsh/node_modules/@tanstack/react-query"],
      "expo-location": ["services/dsh/node_modules/expo-location"],
      "expo-notifications": ["services/dsh/node_modules/expo-notifications"],
      "expo-secure-store": ["services/dsh/node_modules/expo-secure-store"],
      "expo-constants": ["services/dsh/node_modules/expo-constants"],
      "expo-crypto": ["services/dsh/node_modules/expo-crypto"],
      "@dsh-shared/*": ["services/dsh/frontend/shared/*"],
      "@bthwani/dsh/control-panel": ["services/dsh/frontend/control-panel/index.ts"],
      "@bthwani/dsh/control-panel/*": ["services/dsh/frontend/control-panel/*"],
      "@bthwani/control-panel": ["shared/control-panel/src/index.ts"],
      "@bthwani/control-panel/components": ["shared/control-panel/src/components/index.ts"],
      "@bthwani/control-panel/shell": ["shared/control-panel/src/shell/index.ts"]
    },
    "target": "ES2022",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "exactOptionalPropertyTypes": false,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": false,
    "types": [
      "node",
      "react",
      "react-dom"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "stubs/expo-image-picker-web.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist",
    "build"
  ]
}
