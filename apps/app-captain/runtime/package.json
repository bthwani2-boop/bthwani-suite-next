{
  "name": "@bthwani/app-captain-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "node ../../../tools/mobile/verify-mobile-source.mjs --app app-captain",
    "test:app": "node --test tests/*.test.mjs",
    "test:runtime": "node ../../../tools/mobile/test-mobile-runtime-contract.mjs --app app-captain",
    "test": "pnpm run test:app && pnpm run test:runtime",
    "build": "node ../../../tools/mobile/verify-mobile-export.mjs --app app-captain",
    "eas-build-pre-install": "node ../../../tools/mobile/verify-eas-provider-inputs.mjs --app app-captain"
  },
  "devDependencies": {
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "dependencies": {
    "@bthwani/core-identity": "workspace:*",
    "@bthwani/data-runtime": "workspace:*",
    "@bthwani/dsh": "workspace:*",
    "@bthwani/ui-kit": "workspace:*",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "~8.23.0",
    "expo": "^57.0.0",
    "expo-battery": "~57.0.1",
    "expo-constants": "~57.0.9",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-document-picker": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-image-picker": "~57.0.8",
    "expo-linking": "~57.0.5",
    "expo-location": "~57.0.8",
    "expo-notifications": "~57.0.9",
    "expo-router": "~57.0.11",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.12",
    "react": "19.2.8",
    "react-native": "0.87.0",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-maps": "1.29.0",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.27.0",
    "react-native-worklets": "0.12.1"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
