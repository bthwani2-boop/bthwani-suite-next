{
  "name": "@bthwani/app-captain-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "node ../../../tools/mobile/verify-mobile-source.mjs --app app-captain",
    "test:app": "node --test tests/*.test.mjs",
    "test:runtime": "node ../../../tools/mobile/test-mobile-runtime-contract.mjs --app app-captain",
    "test": "pnpm run test:app && pnpm run test:runtime",
    "build": "node ../../../tools/mobile/verify-mobile-export.mjs --app app-captain",
    "eas-build-pre-install": "node ../../../tools/mobile/verify-eas-provider-inputs.mjs --app app-captain"
  },
  "devDependencies": {
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "dependencies": {
    "@bthwani/core-identity": "workspace:*",
    "@bthwani/data-runtime": "workspace:*",
    "@bthwani/dsh": "workspace:*",
    "@bthwani/ui-kit": "workspace:*",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "~7.11.0",
    "expo": "~56.0.19",
    "expo-battery": "~56.0.4",
    "expo-constants": "~56.0.23",
    "expo-crypto": "~56.0.4",
    "expo-dev-client": "~56.0.24",
    "expo-document-picker": "~56.0.4",
    "expo-image-picker": "~56.0.23",
    "expo-linking": "~56.0.16",
    "expo-location": "~56.0.23",
    "expo-notifications": "~56.0.23",
    "expo-router": "~56.2.18",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.14",
    "expo-status-bar": "~56.0.4",
    "expo-updates": "~56.0.24",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2"
  },
  "expo": {
    "install": {
      "exclude": ["typescript"]
    }
  }
}
