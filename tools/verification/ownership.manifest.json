{
  "schemaVersion": 1,
  "authority": "BThwani repository verification ownership",
  "references": {
    "mobile": "tools/mobile/mobile-apps.manifest.json"
  },
  "projects": {
    "identity": {
      "kind": "shared-service-client",
      "root": "core/identity",
      "sourcePrefixes": ["core/identity/clients/"],
      "coverage": { "strategy": "node-lcov", "cwd": "core/identity", "nodeOptions": ["--experimental-loader", "../../tools/scripts/sonar-ts-loader.mjs"], "testRoots": ["core/identity/tests"] }
    },
    "platform-control": {
      "kind": "shared-service-manifest",
      "root": "core/platform-control",
      "sourcePrefixes": ["core/platform-control/service.manifest.ts"],
      "coverage": {
        "strategy": "required",
        "reason": "Platform Control service manifest is an executable contract/configuration; backend coverage is owned by the platform Go coverage matrix."
      }
    },
    "providers": {
      "kind": "shared-service-manifest",
      "root": "core/providers",
      "sourcePrefixes": ["core/providers/service.manifest.ts"],
      "coverage": {
        "strategy": "required",
        "reason": "Providers service manifest is an executable contract/configuration; backend coverage is owned by the providers Go coverage matrix."
      }
    },
    "data-runtime": {
      "kind": "shared-runtime",
      "root": "shared/data-runtime",
      "sourcePrefixes": ["shared/data-runtime/src/"],
      "coverage": { "strategy": "node-lcov", "cwd": "shared/data-runtime", "nodeOptions": ["--experimental-loader", "../../tools/scripts/sonar-ts-loader.mjs"], "testRoots": ["shared/data-runtime/tests"] }
    },
    "dsh": {
      "kind": "domain",
      "root": "services/dsh",
      "sourcePrefixes": [
        "services/dsh/capability-map.extensions.ts",
        "services/dsh/capability-map.ts",
        "services/dsh/capabilities.ts",
        "services/dsh/frontend/",
        "services/dsh/runtime-map.ts",
        "services/dsh/service.manifest.ts",
        "services/dsh/surface-map.ts"
      ],
      "coverage": {
        "strategy": "node-lcov",
        "cwd": ".",
        "prepare": ["pnpm", "--dir", "services/dsh", "run", "build:ts"],
        "nodeOptions": ["--experimental-loader", "./tools/scripts/sonar-ts-loader.mjs"],
        "testRoots": ["services/dsh/tests/coverage"]
      }
    },
    "wlt": {
      "kind": "domain",
      "root": "services/wlt",
      "sourcePrefixes": ["services/wlt/frontend/", "services/wlt/service.manifest.ts"],
      "coverage": {
        "strategy": "required",
        "reason": "WLT frontend runtime is DSH-owned; WLT service coverage is provided by the Go coverage matrix."
      }
    },
    "app-field": {
      "kind": "mobile-surface",
      "root": "apps/app-field/runtime",
      "sourcePrefixes": ["apps/app-field/runtime/"],
      "coverage": { "strategy": "node-lcov", "cwd": "apps/app-field/runtime", "nodeOptions": ["--experimental-loader", "../../../tools/scripts/sonar-ts-loader.mjs"], "testRoots": ["apps/app-field/runtime/tests"] }
    },
    "app-captain": {
      "kind": "mobile-surface",
      "root": "apps/app-captain/runtime",
      "sourcePrefixes": ["apps/app-captain/runtime/"],
      "coverage": { "strategy": "node-lcov", "cwd": "apps/app-captain/runtime", "nodeOptions": ["--experimental-loader", "../../../tools/scripts/sonar-ts-loader.mjs"], "testRoots": ["apps/app-captain/runtime/tests"] }
    },
    "app-client": {
      "kind": "mobile-surface",
      "root": "apps/app-client/runtime",
      "sourcePrefixes": ["apps/app-client/runtime/"],
      "coverage": { "strategy": "node-lcov", "cwd": "apps/app-client/runtime", "nodeOptions": ["--experimental-loader", "../../../tools/scripts/sonar-ts-loader.mjs"], "testRoots": ["apps/app-client/runtime/tests"] }
    },
    "app-partner": {
      "kind": "mobile-surface",
      "root": "apps/app-partner/runtime",
      "sourcePrefixes": ["apps/app-partner/runtime/"],
      "coverage": { "strategy": "node-lcov", "cwd": "apps/app-partner/runtime", "nodeOptions": ["--experimental-loader", "../../../tools/scripts/sonar-ts-loader.mjs"], "testRoots": ["apps/app-partner/runtime/tests"] }
    },
    "control-panel-config": {
      "kind": "web-runtime-config",
      "root": "apps/control-panel/runtime",
      "sourcePrefixes": ["apps/control-panel/runtime/next.config.mjs", "apps/control-panel/runtime/stubs/"],
      "coverage": {
        "strategy": "node-lcov",
        "cwd": ".",
        "nodeOptions": ["--experimental-loader", "./tools/scripts/sonar-ts-loader.mjs"],
        "testRoots": ["apps/control-panel/runtime/tests"]
      }
    },
    "control-panel": {
      "kind": "web-surface",
      "root": "apps/control-panel/runtime",
      "sourcePrefixes": ["apps/control-panel/runtime/src/", "shared/control-panel/src/"],
      "coverage": { "strategy": "node-lcov", "cwd": ".", "nodeOptions": ["--experimental-loader", "./tools/scripts/sonar-ts-loader.mjs"], "testRoots": ["apps/control-panel/runtime/tests"] }
    },
    "ui-kit": {
      "kind": "shared-ui",
      "root": "shared/ui-kit",
      "sourcePrefixes": ["shared/ui-kit/src/"],
      "coverage": { "strategy": "node-lcov", "cwd": ".", "nodeOptions": ["--experimental-loader", "./tools/scripts/sonar-ts-loader.mjs"], "testRoots": ["shared/ui-kit/tests"] }
    }
  },
  "sonar": {
    "governedJavaScriptTypeScriptRoots": ["apps/", "core/", "services/", "shared/"],
    "verificationPrefixes": [
      "tools/mobile/",
      "apps/app-client/runtime/tests/",
      "apps/app-partner/runtime/tests/",
      "apps/app-captain/runtime/tests/",
      "apps/app-field/runtime/tests/",
      "apps/control-panel/runtime/tests/",
      "core/identity/tests/",
      "services/dsh/tests/",
      "services/wlt/tests/",
      "shared/data-runtime/tests/",
      "shared/ui-kit/tests/"
    ],
    "generatedPrefixes": ["services/dsh/clients/generated/", "services/wlt/clients/generated/"]
  }
}
