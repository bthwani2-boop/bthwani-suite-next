{
  "schemaVersion": 1,
  "authority": "BThwani repository verification ownership",
  "references": {
    "mobile": "tools/mobile/mobile-apps.manifest.json"
  },
  "projects": {
    "identity": {
      "kind": "shared-service-client",
      "root": "core/identity",
      "sourcePrefixes": ["core/identity/clients/"],
      "coverage": { "strategy": "node-lcov", "cwd": "core/identity", "testRoots": ["core/identity/tests"] }
    },
    "data-runtime": {
      "kind": "shared-runtime",
      "root": "shared/data-runtime",
      "sourcePrefixes": ["shared/data-runtime/src/"],
      "coverage": { "strategy": "node-lcov", "cwd": "shared/data-runtime", "testRoots": ["shared/data-runtime/tests"] }
    },
    "dsh": {
      "kind": "domain",
      "root": "services/dsh",
      "sourcePrefixes": ["services/dsh/frontend/"],
      "coverage": {
        "strategy": "node-lcov",
        "cwd": ".",
        "prepare": ["pnpm", "--dir", "services/dsh", "exec", "tsc", "-p", "tsconfig.json"],
        "testRoots": [
          "services/dsh/tests",
          "apps/app-client/runtime/tests",
          "apps/app-partner/runtime/tests",
          "apps/app-captain/runtime/tests",
          "apps/app-field/runtime/tests",
          "apps/mobile/tests"
        ]
      }
    },
    "wlt": {
      "kind": "domain",
      "root": "services/wlt",
      "sourcePrefixes": ["services/wlt/frontend/"],
      "coverage": {
        "strategy": "required",
        "reason": "Current WLT tests validate boundaries and contracts but do not execute services/wlt/frontend source as LCOV evidence."
      }
    },
    "app-field": {
      "kind": "mobile-surface",
      "root": "apps/app-field/runtime",
      "sourcePrefixes": ["apps/app-field/runtime/src/"],
      "coverage": { "strategy": "node-lcov", "cwd": "apps/app-field/runtime", "testRoots": ["apps/app-field/runtime/tests"] }
    },
    "app-captain": {
      "kind": "mobile-surface",
      "root": "apps/app-captain/runtime",
      "sourcePrefixes": ["apps/app-captain/runtime/src/"],
      "coverage": { "strategy": "node-lcov", "cwd": "apps/app-captain/runtime", "testRoots": ["apps/app-captain/runtime/tests"] }
    },
    "app-client": {
      "kind": "mobile-surface",
      "root": "apps/app-client/runtime",
      "sourcePrefixes": ["apps/app-client/runtime/src/"],
      "coverage": { "strategy": "required", "reason": "No app-client-owned executable LCOV suite exists yet; source changes must not pass as uncovered ownership." }
    },
    "app-partner": {
      "kind": "mobile-surface",
      "root": "apps/app-partner/runtime",
      "sourcePrefixes": ["apps/app-partner/runtime/src/"],
      "coverage": { "strategy": "required", "reason": "No app-partner-owned executable LCOV suite exists yet; source changes must not pass as uncovered ownership." }
    },
    "control-panel-config": {
      "kind": "web-runtime-config",
      "root": "apps/control-panel/runtime",
      "sourcePrefixes": ["apps/control-panel/runtime/next.config.mjs"],
      "coverage": {
        "strategy": "node-lcov",
        "cwd": ".",
        "testRoots": ["apps/control-panel/runtime/tests"]
      }
    },
    "control-panel": {
      "kind": "web-surface",
      "root": "apps/control-panel/runtime",
      "sourcePrefixes": ["apps/control-panel/runtime/src/", "shared/control-panel/src/"],
      "coverage": { "strategy": "required", "reason": "Control Panel Node contracts do not yet execute the browser application source as LCOV evidence." }
    },
    "ui-kit": {
      "kind": "shared-ui",
      "root": "shared/ui-kit",
      "sourcePrefixes": ["shared/ui-kit/src/"],
      "coverage": { "strategy": "required", "reason": "UI kit has typecheck/boundary evidence but no executable LCOV owner yet." }
    }
  },
  "sonar": {
    "governedJavaScriptTypeScriptRoots": ["apps/", "core/", "services/", "shared/"],
    "verificationPrefixes": [
      "apps/mobile/",
      "apps/app-client/runtime/tests/",
      "apps/app-partner/runtime/tests/",
      "apps/app-captain/runtime/tests/",
      "apps/app-field/runtime/tests/",
      "apps/control-panel/runtime/tests/",
      "core/identity/tests/",
      "services/dsh/tests/",
      "services/wlt/tests/",
      "shared/data-runtime/tests/"
    ],
    "generatedPrefixes": ["services/dsh/clients/generated/", "services/wlt/clients/generated/"]
  }
}
