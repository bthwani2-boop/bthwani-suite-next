{
  "global": {
    "owner": "bthwani1",
    "appLine": "next",
    "sourceRepo": "bthwani-suite-next",
    "version": "0.3.0",
    "node": "24.17.0",
    "pnpm": "10.34.0",
    "runtimeTypeScript": "npm:@typescript/typescript6@6.0.2",
    "capabilityModelVersion": 1,
    "navigationArchitecture": {
      "target": "expo-router",
      "decision": "ADOPTED_TARGET_ARCHITECTURE",
      "implementation": "DEFERRED_UNTIL_STABILITY",
      "appliesTo": ["app-client", "app-partner", "app-captain", "app-field"],
      "migrationMode": "ONE_APP_AT_A_TIME_FAIL_CLOSED",
      "remoteBuildNow": false,
      "migrationOrder": ["app-field", "app-captain", "app-partner", "app-client"],
      "requiredStabilityGates": ["productJourneys", "backendContracts", "mobileAppShell", "deepLinksAndNotifications", "regressionBaseline", "routeContracts", "parityTests"]
    },
    "mediaArchitecture": {
      "decision": "CAPABILITY_CONSOLIDATION_FIRST",
      "remoteBuildNow": false,
      "owners": {
        "systemCameraPhotoCapture": { "package": "expo-image-picker", "status": "CANONICAL_ACTIVE" },
        "imageLibraryPick": { "package": "expo-image-picker", "status": "CANONICAL_ACTIVE" },
        "customCameraPreview": { "package": "expo-camera", "status": "REQUIREMENT_REVIEW_PENDING" },
        "barcodeScanning": { "package": "expo-camera", "status": "REQUIREMENT_REVIEW_PENDING" },
        "videoPlayback": { "package": "expo-video", "status": "CANONICAL_ACTIVE" },
        "standaloneAudio": { "package": "expo-audio", "status": "REQUIREMENT_REVIEW_PENDING" },
        "documentPick": { "package": "expo-document-picker", "status": "CANONICAL_ACTIVE" },
        "fileOperations": { "package": "expo-file-system", "status": "CANONICAL_ACTIVE_WHERE_CONSUMED" },
        "sharing": { "package": "expo-sharing", "status": "CANONICAL_ACTIVE_WHERE_CONSUMED" },
        "imageRendering": { "package": "expo-image", "status": "CANONICAL_ACTIVE_WHERE_CONSUMED" },
        "imageTransform": { "package": "expo-image-manipulator", "status": "CONSUMER_REVIEW_PENDING" }
      },
      "rules": {
        "ordinaryPhotoCaptureMustNotRequireExpoCamera": true,
        "broaderPackageWinsOnlyWhenMultipleRequiredCapabilitiesAreActuallyUsed": true,
        "duplicateCapabilityOwnersRequireExplicitJustification": true,
        "nativeRemovalDeferredToCleanupWindow": true,
        "packageDeletionRequiresConsumerAndRequirementClosure": true
      }
    },
    "mobilityArchitecture": {
      "decision": "CAPABILITY_CONSOLIDATION_FIRST",
      "remoteBuildNow": false,
      "owners": {
        "foregroundLocation": { "packages": ["expo-location"], "status": "CANONICAL_ACTIVE" },
        "mapRendering": { "packages": ["react-native-maps"], "status": "CANONICAL_ACTIVE" },
        "backgroundLocation": { "packages": ["expo-location", "expo-task-manager"], "status": "COMPOSITE_CAPABILITY" },
        "deferredBackgroundSync": { "packages": ["expo-background-task", "expo-task-manager"], "status": "FIELD_DECLARED_ACTIVE" },
        "powerAwareness": { "packages": ["expo-battery"], "status": "CANONICAL_ACTIVE_CAPTAIN_FIELD" },
        "keepAwake": { "packages": ["expo-keep-awake"], "status": "REQUIREMENT_REVIEW_PENDING" }
      },
      "alignment": {
        "app-captain.backgroundLocation": "REQUIRES_TASK_MANAGER_BEFORE_IMPLEMENTATION",
        "app-field.deferredBackgroundSync": "DECLARED_WITH_TASK_MANAGER"
      },
      "rules": {
        "backgroundLocationRequiresTopLevelTaskDefinition": true,
        "backgroundLocationRequiresTaskManager": true,
        "backgroundTaskMustNotReplaceLocationEngine": true,
        "permissionAndNativeChangesDeferredToBuildWindow": true,
        "packageDeletionRequiresConsumerAndRequirementClosure": true
      }
    },
    "systemArchitecture": {
      "decision": "CAPABILITY_CONSOLIDATION_FIRST",
      "remoteBuildNow": false,
      "owners": {
        "sessionSecretStorage": { "package": "expo-secure-store", "status": "CANONICAL_ACTIVE" },
        "ephemeralIdentifiers": { "package": "expo-crypto", "status": "CANONICAL_ACTIVE" },
        "runtimeConstants": { "package": "expo-constants", "status": "INFRA_ACTIVE" },
        "updatesRuntime": { "package": "expo-updates", "status": "INFRA_ACTIVE" },
        "splashLifecycle": { "package": "expo-splash-screen", "status": "INFRA_ACTIVE" },
        "deepLinking": { "package": "expo-linking", "status": "TARGET_ROUTER_SUPPORT" },
        "biometricUnlock": { "package": "expo-local-authentication", "status": "REQUIREMENT_REVIEW_PENDING" },
        "applicationMetadata": { "package": "expo-application", "status": "CONSUMER_REVIEW_PENDING" },
        "deviceMetadata": { "package": "expo-device", "status": "CONSUMER_REVIEW_PENDING" },
        "localization": { "package": "expo-localization", "status": "REQUIREMENT_REVIEW_PENDING" }
      },
      "alignment": {
        "app-client.localAuthentication": "DECLARED_PENDING_PRODUCT_DECISION",
        "app-partner.localAuthentication": "DECLARED_PENDING_PRODUCT_DECISION",
        "app-field.localAuthentication": "DECLARED_PENDING_PRODUCT_DECISION",
        "app-captain.localAuthentication": "NOT_DECLARED_REVIEW_PENDING"
      },
      "rules": {
        "secureStoreOwnsSecretsNotGeneralCache": true,
        "cryptoDoesNotOwnPersistence": true,
        "routerTargetProtectsLinkingFromPrematureDeprecation": true,
        "biometricUnlockIsLocalReauthOnly": true,
        "biometricUnlockCannotCreateServerSession": true,
        "biometricUnlockCannotBypassIdentityOrWorkforceGates": true,
        "biometricFeatureBindingRequiresDecisionClosure": true,
        "applicationMetadataCannotOwnInstallationIdentity": true,
        "deviceMetadataCannotOwnStableInstallationIdentity": true,
        "stableInstallationIdentityRemainsSecureStoreCrypto": true,
        "metadataFeatureBindingRequiresConsumerProof": true,
        "reviewPendingDoesNotAuthorizeDeletion": true,
        "nativeRemovalDeferredToCleanupWindow": true
      }
    },
    "toolingArchitecture": {
      "decision": "EXPO_METRO_SINGLE_OWNER",
      "remoteBuildNow": false,
      "metro": {
        "base": "expo/metro-config",
        "sentryOwner": "@sentry/react-native/metro#getSentryExpoConfig",
        "appConfigParity": "IDENTICAL_CURRENTLY",
        "manualMonorepoResolution": {
          "status": "COMPATIBILITY_QUARANTINE_PENDING_RUNTIME_PROOF",
          "requiredProof": "expo start --clear plus runtime smoke for all four mobile apps before removal"
        },
        "directReactNativeMetroConfig": {
          "package": "@react-native/metro-config",
          "status": "DEPRECATION_CANDIDATE",
          "removalGate": "explicit package approval plus package/lockfile update plus Metro smoke; no EAS build solely for this tooling dependency"
        }
      },
      "rules": {
        "expoMetroConfigIsCanonical": true,
        "sentryMetroIntegrationMustRemain": true,
        "manualMonorepoOverridesRequireRuntimeProofBeforeRemoval": true,
        "reactNativeMetroConfigMustNotBeImportedByExpoApps": true,
        "metadataOnlyGovernanceMustNotTriggerNativeBuild": true
      }
    }
  },
