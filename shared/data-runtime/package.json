{
  "name": "@bthwani/data-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./native-data-adapters": "./src/native-data-adapters.ts",
    "./connectivity-adapter": "./src/connectivity-adapter.ts",
    "./storage-adapter": "./src/storage-adapter.ts",
    "./mutation-identity-scope": "./src/mutation-identity-scope.ts",
    "./installation-id": "./src/installation-id.ts",
    "./current-actor": "./src/current-actor.ts",
    "./identity-bridge": "./src/identity-bridge.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:ts7": "tsc --noEmit -p tsconfig.json",
    "typecheck:ts6:compat": "tsc6 --noEmit -p tsconfig.json",
    "typecheck:all": "pnpm run typecheck:ts7 && pnpm run typecheck:ts6:compat",
    "build": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "react": "19.2.3",
    "@react-native-community/netinfo": "*",
    "expo-battery": "*"
  },
  "peerDependenciesMeta": {
    "@react-native-community/netinfo": {
      "optional": true
    },
    "expo-battery": {
      "optional": true
    }
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "5.90.2"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "typescript": "7.0.2",
    "@typescript/typescript6": "6.0.2"
  }
}
