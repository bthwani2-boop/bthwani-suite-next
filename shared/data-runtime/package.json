{
  "name": "@bthwani/data-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:ts7": "tsc --noEmit -p tsconfig.json",
    "typecheck:ts6:compat": "tsc6 --noEmit -p tsconfig.json",
    "typecheck:all": "pnpm run typecheck:ts7 && pnpm run typecheck:ts6:compat",
    "build": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "react": "19.2.3",
    "@react-native-community/netinfo": "*"
  },
  "peerDependenciesMeta": {
    "@react-native-community/netinfo": {
      "optional": true
    }
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "3.1.1",
    "@tanstack/react-query": "5.101.4"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "typescript": "7.0.2",
    "@typescript/typescript6": "6.0.2"
  }
}
