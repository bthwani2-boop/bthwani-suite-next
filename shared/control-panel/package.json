{
  "name": "@bthwani/control-panel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./components": "./src/components/index.ts",
    "./shell": "./src/shell/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:ts": "tsc --noEmit -p tsconfig.json",
    "typecheck:ts6:compat": "tsc6 --noEmit -p tsconfig.json",
    "typecheck:all": "pnpm run typecheck:ts && pnpm run typecheck:ts6:compat",
    "build": "tsc --noEmit -p tsconfig.json",
    "lint": "pnpm --dir ../.. run guard:ui-kit-boundary"
  },
  "dependencies": {
    "@bthwani/ui-kit": "workspace:*"
  },
  "peerDependencies": {
    "react": "19.2.3"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "typescript": "6.0.2",
    "@typescript/typescript6": "6.0.2"
  }
}
