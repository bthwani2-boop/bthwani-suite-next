{
  "name": "@bthwani/core-platform-control",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "clients/generated/platform-control-api.ts",
  "types": "clients/generated/platform-control-api.ts",
  "exports": {
    ".": "./clients/generated/platform-control-api.ts"
  },
  "scripts": {
    "openapi:compose": "node ../../tools/scripts/compose-openapi-context.mjs platform-control",
    "openapi:generate": "pnpm run openapi:compose && pnpm exec openapi-typescript contracts/generated/platform-control.bundle.openapi.yaml -o clients/generated/platform-control-api.ts",
    "test": "cd backend && go test ./...",
    "build": "node ../../tools/scripts/verify-go-build.mjs backend",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:ts": "tsc --noEmit -p tsconfig.json",
    "typecheck:ts6:compat": "tsc6 --noEmit -p tsconfig.json",
    "typecheck:all": "pnpm run typecheck:ts && pnpm run typecheck:ts6:compat"
  },
  "peerDependencies": {
    "react": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "react": "19.2.8",
    "typescript": "6.0.2",
    "@typescript/typescript6": "6.0.2"
  }
}
