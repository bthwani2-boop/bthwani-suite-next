{
  "name": "@bthwani/core-identity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "clients/index.ts",
  "types": "clients/index.ts",
  "scripts": {
    "openapi:compose": "node ../../tools/scripts/compose-openapi-context.mjs identity",
    "openapi:generate": "pnpm run openapi:compose && pnpm exec openapi-typescript contracts/generated/identity.bundle.openapi.yaml -o clients/generated/identity-api.ts",
    "test": "cd backend && go test ./...",
    "build": "node ../../tools/scripts/verify-go-build.mjs backend",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "react": "19.2.3"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "react": "19.2.3",
    "typescript": "7.0.2"
  },
  "exports": {
    ".": "./clients/index.ts",
    "./server": "./clients/identity-client.ts"
  }
}
