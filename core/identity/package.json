{
  "name": "@bthwani/core-identity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "clients/index.ts",
  "types": "clients/index.ts",
  "scripts": {
    "openapi:compose": "node ../../tools/scripts/compose-openapi-context.mjs identity",
    "openapi:generate": "pnpm run openapi:compose && pnpm exec openapi-typescript contracts/generated/identity.bundle.openapi.yaml -o clients/generated/identity-api.ts",
    "test": "cd backend && go test ./... && cd .. && go test -C clients/go/identityauth ./... && node --test tests/*.test.mjs",
    "build": "node ../../tools/scripts/verify-go-build.mjs backend && go build -C clients/go/identityauth ./...",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:ts": "tsc --noEmit -p tsconfig.json",
    "typecheck:ts6:compat": "tsc6 --noEmit -p tsconfig.json",
    "typecheck:all": "pnpm run typecheck:ts && pnpm run typecheck:ts6:compat",
    "lint": "node ../../tools/guards/core-package-dependency-boundary-gate.mjs --package identity"
  },
  "peerDependencies": {
    "react": "19.2.3"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "react": "19.2.3",
    "typescript": "6.0.2",
    "@typescript/typescript6": "6.0.2"
  },
  "exports": {
    ".": "./clients/index.ts",
    "./server": "./clients/identity-client.ts",
    "./session-policy": "./clients/identity-session-policy.ts",
    "./secure-random": "./clients/secure-random.ts"
  }
}
