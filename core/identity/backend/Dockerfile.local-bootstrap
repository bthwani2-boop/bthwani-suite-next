FROM golang:1.26.5-alpine AS build
WORKDIR /src
COPY core/identity/backend/go.mod core/identity/backend/go.sum* ./
RUN go mod download
COPY core/identity/backend/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/identity-local-bootstrap ./cmd/identity-local-bootstrap

FROM alpine:3.21
RUN addgroup -S app && adduser -S app -G app
USER app
COPY --from=build /out/identity-local-bootstrap /identity-local-bootstrap
ENTRYPOINT ["/identity-local-bootstrap"]
