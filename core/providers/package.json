{
  "name": "@bthwani/core-providers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "clients/generated/providers-api.ts",
  "types": "clients/generated/providers-api.ts",
  "exports": {
    ".": "./clients/generated/providers-api.ts"
  },
  "scripts": {
    "openapi:compose": "node ../../tools/scripts/compose-openapi-context.mjs providers",
    "openapi:generate": "pnpm run openapi:compose && pnpm exec openapi-typescript contracts/generated/providers.bundle.openapi.yaml -o clients/generated/providers-api.ts",
    "test": "cd backend && go test ./...",
    "build": "node ../../tools/scripts/verify-go-build.mjs backend",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:ts": "tsc --noEmit -p tsconfig.json",
    "typecheck:ts6:compat": "tsc6 --noEmit -p tsconfig.json",
    "typecheck:all": "pnpm run typecheck:ts && pnpm run typecheck:ts6:compat",
    "lint": "node ../../tools/guards/core-package-dependency-boundary-gate.mjs --package providers"
  },
  "devDependencies": {
    "typescript": "6.0.2",
    "@typescript/typescript6": "6.0.2"
  }
}
